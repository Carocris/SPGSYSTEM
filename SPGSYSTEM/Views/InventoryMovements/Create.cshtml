@model Application.ViewModels.InventoryMovement.InventoryMovementSaveViewModel
@{
    ViewData["Title"] = "Nuevo Movimiento de Inventario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="fas fa-plus me-2"></i>Nuevo Movimiento de Inventario
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProductId" class="form-label">
                                <i class="fas fa-box me-1"></i>Producto
                            </label>
                            <select asp-for="ProductId" class="form-select" id="productSelect">
                                <option value="">Seleccione un producto</option>
                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Id">@product.Code - @product.Name</option>
                                }
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                <i class="fas fa-info-circle me-1"></i>Información del Producto
                            </label>
                            <div id="productInfo" class="form-control-plaintext">
                                <small class="text-muted">Seleccione un producto para ver su información</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MovementType" class="form-label">
                                <i class="fas fa-exchange-alt me-1"></i>Tipo de Movimiento
                            </label>
                            <select asp-for="MovementType" class="form-select">
                                <option value="">Seleccione el tipo</option>
                                <option value="Entrada">Entrada</option>
                                <option value="Salida">Salida</option>
                                <option value="Ajuste">Ajuste</option>
                            </select>
                            <span asp-validation-for="MovementType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label">
                                <i class="fas fa-sort-numeric-up me-1"></i>Cantidad
                            </label>
                            <input asp-for="Quantity" type="number" min="1" class="form-control" placeholder="Ingrese la cantidad" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label">
                            <i class="fas fa-comment me-1"></i>Motivo
                        </label>
                        <input asp-for="Reason" class="form-control" placeholder="Ingrese el motivo del movimiento" />
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReferenceType" class="form-label">
                                <i class="fas fa-tag me-1"></i>Tipo de Referencia
                            </label>
                            <select asp-for="ReferenceType" class="form-select">
                                <option value="">Sin referencia</option>
                                <option value="Venta">Venta</option>
                                <option value="Compra">Compra</option>
                                <option value="Ajuste">Ajuste</option>
                                <option value="Manual">Manual</option>
                                <option value="Otro">Otro</option>
                            </select>
                            <span asp-validation-for="ReferenceType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ReferenceNumber" class="form-label">
                                <i class="fas fa-hashtag me-1"></i>Número de Referencia
                            </label>
                            <input asp-for="ReferenceNumber" class="form-control" placeholder="Número de factura, orden, etc." />
                            <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">
                            <i class="fas fa-sticky-note me-1"></i>Notas Adicionales
                        </label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Notas adicionales sobre el movimiento"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Registrar Movimiento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Cargar información del producto cuando se seleccione
            $('#productSelect').change(function() {
                var productId = $(this).val();
                if (productId) {
                    $.get('@Url.Action("GetProductInfo")', { productId: productId })
                        .done(function(data) {
                            if (data.success) {
                                $('#productInfo').html(`
                                    <strong>${data.productName}</strong><br>
                                    <small class="text-muted">Código: ${data.productCode}</small><br>
                                    <small class="text-info">Stock actual: ${data.currentStock} unidades</small>
                                `);
                            } else {
                                $('#productInfo').html('<small class="text-danger">Error al cargar información</small>');
                            }
                        })
                        .fail(function() {
                            $('#productInfo').html('<small class="text-danger">Error al cargar información</small>');
                        });
                } else {
                    $('#productInfo').html('<small class="text-muted">Seleccione un producto para ver su información</small>');
                }
            });

            // Validación de cantidad para salidas
            $('#MovementType').change(function() {
                var movementType = $(this).val();
                var quantityInput = $('#Quantity');
                
                if (movementType === 'Salida') {
                    var currentStock = parseInt($('#productInfo').text().match(/Stock actual: (\d+)/)?.[1] || 0);
                    quantityInput.attr('max', currentStock);
                    quantityInput.attr('title', `Stock disponible: ${currentStock} unidades`);
                } else {
                    quantityInput.removeAttr('max');
                    quantityInput.removeAttr('title');
                }
            });
        });
    </script>
} 