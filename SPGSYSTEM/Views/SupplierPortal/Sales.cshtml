@model List<Application.ViewModels.Sale.SaleViewModel>

@{
    ViewData["Title"] = "Mis Ventas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header con estadísticas -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h2 class="mb-1">
                                <i class="fas fa-chart-line text-primary me-2"></i>
                                Ventas de @ViewBag.SupplierName
                            </h2>
                            <p class="text-muted mb-0">Panel de control de ventas y rendimiento</p>
                        </div>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver al Portal
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tarjetas de estadísticas mejoradas -->
            <div class="row mb-4">
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <div class="bg-primary bg-gradient rounded-circle p-3 me-3">
                                    <i class="fas fa-shopping-cart text-white fa-lg"></i>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold text-primary">@ViewBag.TotalSales</h3>
                                    <p class="text-muted mb-0">Total de Ventas</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <div class="bg-success bg-gradient rounded-circle p-3 me-3">
                                    <i class="fas fa-dollar-sign text-white fa-lg"></i>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold text-success">$@ViewBag.TotalRevenue.ToString("N2")</h3>
                                    <p class="text-muted mb-0">Ingresos Totales</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <div class="bg-info bg-gradient rounded-circle p-3 me-3">
                                    <i class="fas fa-users text-white fa-lg"></i>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold text-info">@(Model?.Select(s => s.CustomerName).Distinct().Count() ?? 0)</h3>
                                    <p class="text-muted mb-0">Clientes Únicos</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center mb-3">
                                <div class="bg-warning bg-gradient rounded-circle p-3 me-3">
                                    <i class="fas fa-calendar-alt text-white fa-lg"></i>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold text-warning">@(Model?.Where(s => s.SaleDate.Date == DateTime.Today).Count() ?? 0)</h3>
                                    <p class="text-muted mb-0">Ventas Hoy</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alertas -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Tabla de ventas mejorada -->
            @if (Model != null && Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-list me-2 text-primary"></i>
                            Historial de Ventas
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" id="salesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0">
                                            <i class="fas fa-hashtag me-1"></i>ID
                                        </th>
                                        <th class="border-0">
                                            <i class="fas fa-calendar me-1"></i>Fecha
                                        </th>
                                        <th class="border-0">
                                            <i class="fas fa-user me-1"></i>Cliente
                                        </th>
                                        <th class="border-0">
                                            <i class="fas fa-box me-1"></i>Productos
                                        </th>
                                        <th class="border-0">
                                            <i class="fas fa-dollar-sign me-1"></i>Total
                                        </th>
                                        <th class="border-0">
                                            <i class="fas fa-credit-card me-1"></i>Estado
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sale in Model)
                                    {
                                        <tr class="border-bottom">
                                            <td class="align-middle">
                                                <span class="badge bg-primary rounded-pill">#@sale.Id</span>
                                            </td>
                                            <td class="align-middle">
                                                <div class="d-flex flex-column">
                                                    <span class="fw-bold">@sale.SaleDate.ToString("dd/MM/yyyy")</span>
                                                    <small class="text-muted">@sale.SaleDate.ToString("HH:mm")</small>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary bg-gradient rounded-circle p-2 me-2">
                                                        <i class="fas fa-user text-white fa-sm"></i>
                                                    </div>
                                                    <span class="fw-semibold">@sale.CustomerName</span>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                @if (sale.Details != null && sale.Details.Any())
                                                {
                                                    <div class="product-list">
                                                        @foreach (var detail in sale.Details.Where(d => d.SupplierId == ViewBag.SupplierId))
                                                        {
                                                            <div class="product-item d-flex align-items-center mb-1">
                                                                <div class="bg-success bg-gradient rounded-circle p-1 me-2">
                                                                    <i class="fas fa-box text-white fa-xs"></i>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <span class="fw-semibold">@detail.ProductName</span>
                                                                    <br>
                                                                    <small class="text-muted">
                                                                        Cantidad: @detail.Quantity | Subtotal: $@detail.Subtotal.ToString("N2")
                                                                    </small>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td class="align-middle">
                                                <span class="fw-bold text-success fs-5">$@sale.TotalAmount.ToString("N2")</span>
                                            </td>
                                            <td class="align-middle">
                                                @if (sale.IsPaid)
                                                {
                                                    <span class="badge bg-success rounded-pill">
                                                        <i class="fas fa-check me-1"></i>Pagado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning rounded-pill">
                                                        <i class="fas fa-clock me-1"></i>Pendiente
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-shopping-cart fa-4x text-muted"></i>
                        </div>
                        <h4 class="text-muted mb-3">No hay ventas registradas</h4>
                        <p class="text-muted mb-4">Aún no se han realizado ventas de tus productos. ¡Sigue trabajando en tu catálogo!</p>
                        <a asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Agregar Productos
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .product-list {
        max-height: 120px;
        overflow-y: auto;
    }
    
    .product-item {
        padding: 0.5rem;
        border-radius: 0.375rem;
        background-color: #f8f9fa;
        margin-bottom: 0.25rem;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    .bg-gradient {
        background: linear-gradient(45deg, var(--bs-primary), var(--bs-primary-rgb));
    }
    
    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar DataTable con configuración mejorada
            if ($.fn.DataTable) {
                $('#salesTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json"
                    },
                    "order": [[1, "desc"]], // Ordenar por fecha descendente
                    "pageLength": 10,
                    "responsive": true,
                    "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                           '<"row"<"col-sm-12"tr>>' +
                           '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                    "columnDefs": [
                        { "orderable": false, "targets": [2, 3, 5] } // Deshabilitar ordenamiento en columnas específicas
                    ]
                });
            }
            
            // Animación para las tarjetas de estadísticas
            $('.card').each(function(index) {
                $(this).css('animation-delay', (index * 0.1) + 's');
            });
        });
    </script>
} 