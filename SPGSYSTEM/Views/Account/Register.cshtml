@model Identity.DTOs.RegisterRequest
@{
    ViewData["Title"] = "Registro - InventarioPro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - InventarioPro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .input-focus:focus {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 123, 255, 0.15);
        }
        
        .btn-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.4);
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .slide-in {
            animation: slideIn 0.6s ease-out;
        }
        
        @@keyframes slideIn {
            from { transform: translateX(-100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        .pulse-animation {
            animation: pulse 2s infinite;
        }
        
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body class="flex items-center justify-center p-2 sm:p-4 min-h-screen">
    <div class="container mx-auto max-w-6xl px-4">
        <div class="grid lg:grid-cols-2 gap-4 lg:gap-8 items-center">
            <!-- Sección de Información -->
            <div class="hidden lg:block slide-in">
                <div class="glass-effect rounded-2xl p-6 lg:p-8 text-white">
                    <div class="mb-6 lg:mb-8">
                        <div class="flex items-center mb-4">
                            <i class="fas fa-user-plus text-3xl lg:text-4xl mr-3 text-blue-300"></i>
                            <h1 class="text-2xl lg:text-3xl font-bold">Únete como Cliente</h1>
                        </div>
                        <p class="text-base lg:text-lg text-gray-200 leading-relaxed">
                            Crea tu cuenta de cliente y accede a nuestro catálogo de productos. 
                            Realiza compras de manera fácil y segura.
                        </p>
                    </div>
                    
                    <div class="mb-6">
                        <h3 class="text-lg lg:text-xl font-semibold mb-4 text-blue-200">Beneficios para Clientes</h3>
                        <div class="space-y-3">
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-3 text-green-300"></i>
                                <span class="text-sm lg:text-base">Acceso al catálogo de productos</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-3 text-green-300"></i>
                                <span class="text-sm lg:text-base">Realizar compras en línea</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-3 text-green-300"></i>
                                <span class="text-sm lg:text-base">Historial de compras</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-3 text-green-300"></i>
                                <span class="text-sm lg:text-base">Notificaciones de productos</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-6 lg:mt-8">
                        <div class="flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-4 text-xs lg:text-sm">
                            <div class="flex items-center">
                                <i class="fas fa-shield-alt mr-2 text-green-300"></i>
                                <span>Datos protegidos</span>
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-lock mr-2 text-green-300"></i>
                                <span>Encriptación AES-256</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Formulario de Registro -->
            <div class="fade-in">
                <div class="bg-white rounded-2xl shadow-2xl p-4 sm:p-6 lg:p-8 w-full max-w-4xl mx-auto">
                    <!-- Logo -->
                    <div class="text-center mb-6 lg:mb-8">
                        <div class="inline-flex items-center justify-center w-16 h-16 lg:w-20 lg:h-20 bg-gradient-to-br from-green-500 to-blue-600 rounded-full mb-4 pulse-animation">
                            <i class="fas fa-user-plus text-white text-xl lg:text-2xl"></i>
                        </div>
                        <h2 class="text-xl lg:text-2xl font-bold text-gray-800">Registro de Cliente</h2>
                        <p class="text-sm lg:text-base text-gray-600">Crea tu cuenta para acceder a nuestros productos</p>
                    </div>
                    
                    <!-- Mensaje de Error -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 rounded">
                            <div class="flex">
                                <i class="fas fa-exclamation-triangle text-red-400 mr-3 mt-0.5"></i>
                                <div>
                                    <p class="text-sm text-red-700">
                                        @Html.ValidationSummary(false, "", new { @class = "text-red-700" })
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Formulario -->
                    <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="CompanyName" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-building mr-2 text-blue-500"></i>Nombre de la Empresa
                                </label>
                                <input type="text" 
                                       id="CompanyName" 
                                       name="CompanyName" 
                                       asp-for="CompanyName"
                                       class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                       placeholder="Nombre de su empresa">
                                <span asp-validation-for="CompanyName" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            
                            <div>
                                <label for="ContactName" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-user mr-2 text-blue-500"></i>Persona de Contacto
                                </label>
                                <input type="text" 
                                       id="ContactName" 
                                       name="ContactName" 
                                       asp-for="ContactName"
                                       class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                       placeholder="Su nombre completo">
                                <span asp-validation-for="ContactName" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="UserName" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-at mr-2 text-blue-500"></i>Usuario
                                </label>
                                <input type="text" 
                                       id="UserName" 
                                       name="UserName" 
                                       asp-for="UserName"
                                       class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                       placeholder="Nombre de usuario">
                                <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            
                            <div>
                                <label for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-envelope mr-2 text-blue-500"></i>Email
                                </label>
                                <input type="email" 
                                       id="Email" 
                                       name="Email" 
                                       asp-for="Email"
                                       class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                       placeholder="su@email.com">
                                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>
                        
                        <div>
                            <label for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-2">
                                <i class="fas fa-phone mr-2 text-blue-500"></i>Teléfono
                            </label>
                            <input type="tel" 
                                   id="PhoneNumber" 
                                   name="PhoneNumber" 
                                   asp-for="PhoneNumber"
                                   class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                   placeholder="809-555-0000">
                            <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs mt-1"></span>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="Password" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-lock mr-2 text-blue-500"></i>Contraseña
                                </label>
                                <div class="relative">
                                    <input type="password" 
                                           id="Password" 
                                           name="Password" 
                                           asp-for="Password"
                                           class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                           placeholder="Mínimo 6 caracteres">
                                    <button type="button" 
                                            id="togglePassword" 
                                            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                            </div>
                            
                            <div>
                                <label for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    <i class="fas fa-lock mr-2 text-blue-500"></i>Confirmar Contraseña
                                </label>
                                <div class="relative">
                                    <input type="password" 
                                           id="ConfirmPassword" 
                                           name="ConfirmPassword" 
                                           asp-for="ConfirmPassword"
                                           class="w-full px-3 sm:px-4 py-2 sm:py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-300 input-focus text-sm sm:text-base"
                                           placeholder="Repita su contraseña">
                                    <button type="button" 
                                            id="toggleConfirmPassword" 
                                            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1"></span>
                            </div>
                        </div>
                        
                        <div class="flex items-center">
                            <input type="checkbox" 
                                   id="AcceptTerms" 
                                   name="AcceptTerms"
                                   class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                            <label for="AcceptTerms" class="ml-2 text-sm text-gray-600">
                                Acepto los <a href="#" class="text-blue-600 hover:text-blue-800">términos y condiciones</a>
                            </label>
                        </div>
                        
                        <button type="submit" 
                                id="registerButton"
                                class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-300 btn-hover font-medium">
                            <span id="buttonText">Registrarse</span>
                            <i id="loadingSpinner" class="fas fa-spinner fa-spin hidden ml-2"></i>
                        </button>
                    </form>
                    
                    <div class="mt-6 space-y-4">
                        <!-- Separador -->
                        <div class="relative">
                            <div class="absolute inset-0 flex items-center">
                                <div class="w-full border-t border-gray-300"></div>
                            </div>
                            <div class="relative flex justify-center text-sm">
                                <span class="px-2 bg-white text-gray-500">¿Ya tienes cuenta?</span>
                            </div>
                        </div>
                        
                        <!-- Botón de Login -->
                        <div class="text-center">
                            <a asp-controller="Account" asp-action="Login" 
                               class="inline-flex items-center justify-center w-full px-4 py-3 border border-gray-300 rounded-lg text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-300 font-medium">
                                <i class="fas fa-sign-in-alt mr-2 text-blue-500"></i>
                                Iniciar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Toggle password visibility
        const togglePassword = document.getElementById('togglePassword');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        const password = document.getElementById('Password');
        const confirmPassword = document.getElementById('ConfirmPassword');
        
        togglePassword.addEventListener('click', function() {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        });
        
        toggleConfirmPassword.addEventListener('click', function() {
            const type = confirmPassword.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPassword.setAttribute('type', type);
            this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
        });
        
        // Validación de contraseñas
        const passwordInput = document.getElementById('Password');
        const confirmPasswordInput = document.getElementById('ConfirmPassword');
        
        function validatePasswords() {
            if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
                confirmPasswordInput.classList.add('border-red-500');
                confirmPasswordInput.setCustomValidity('Las contraseñas no coinciden');
            } else {
                confirmPasswordInput.classList.remove('border-red-500');
                confirmPasswordInput.setCustomValidity('');
            }
        }
        
        passwordInput.addEventListener('input', validatePasswords);
        confirmPasswordInput.addEventListener('input', validatePasswords);
        
        // Manejo del formulario
        const registerForm = document.querySelector('form');
        const registerButton = document.getElementById('registerButton');
        const buttonText = document.getElementById('buttonText');
        const loadingSpinner = document.getElementById('loadingSpinner');
        
        registerForm.addEventListener('submit', function() {
            // Estado de carga
            registerButton.disabled = true;
            buttonText.textContent = 'Registrando...';
            loadingSpinner.classList.remove('hidden');
        });
        
        // Animaciones al cargar
        document.addEventListener('DOMContentLoaded', function() {
            document.body.classList.add('fade-in');
        });
    </script>
</body>
</html> 