@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-danger text-white text-center">
                <h4 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Acceso Denegado
                </h4>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-4">
                    <i class="fas fa-lock fa-3x text-danger mb-3"></i>
                    <h5 class="text-danger">No tienes permisos para acceder a esta página</h5>
                    <p class="text-muted">
                        Lo sentimos, pero no tienes los permisos necesarios para acceder a esta funcionalidad.
                    </p>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-home me-2"></i>Ir al Inicio
                    </a>
                    
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
                        <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                    </a>
                </div>

                <hr class="my-4" />

                <div class="text-center">
                    <small class="text-muted">
                        Si crees que esto es un error, contacta al administrador del sistema.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div> 