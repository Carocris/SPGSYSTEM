@model Application.ViewModels.Supplier.SupplierViewModel

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-truck me-2"></i>
                        Detalles del Proveedor
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i>
                            Editar
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-building me-2"></i>
                                Información de la Empresa
                            </h5>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre:</label>
                                <p class="form-control-plaintext">@Model.Name</p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.TaxId))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">RUC/NIT:</label>
                                    <p class="form-control-plaintext">@Model.TaxId</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.ContactPerson))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Persona de Contacto:</label>
                                    <p class="form-control-plaintext">@Model.ContactPerson</p>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label fw-bold">Estado:</label>
                                <p>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-address-book me-2"></i>
                                Información de Contacto
                            </h5>

                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <p class="form-control-plaintext">
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    </p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Teléfono:</label>
                                    <p class="form-control-plaintext">
                                        <a href="tel:@Model.Phone">@Model.Phone</a>
                                    </p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Dirección:</label>
                                    <p class="form-control-plaintext">@Model.Address</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Ciudad:</label>
                                    <p class="form-control-plaintext">@Model.City</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Country))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">País:</label>
                                    <p class="form-control-plaintext">@Model.Country</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.PostalCode))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Código Postal:</label>
                                    <p class="form-control-plaintext">@Model.PostalCode</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-calendar me-2"></i>
                                Información del Sistema
                            </h5>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">ID del Proveedor:</label>
                                        <p class="form-control-plaintext">@Model.Id</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Fecha de Creación:</label>
                                        <p class="form-control-plaintext">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Usuario Asociado:</label>
                                        <p class="form-control-plaintext">
                                            @if (!string.IsNullOrEmpty(Model.UserId))
                                            {
                                                <span class="badge bg-info">Usuario Configurado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Sin Usuario</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Productos del Proveedor -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-boxes me-2"></i>
                                Productos de este Proveedor
                            </h5>
                            
                            @if (ViewBag.SupplierProducts != null && ((List<Application.ViewModels.Product.ProductViewModel>)ViewBag.SupplierProducts).Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Código</th>
                                                <th>Nombre</th>
                                                <th>Categoría</th>
                                                <th>Precio de Compra</th>
                                                <th>Precio de Venta</th>
                                                <th>Stock</th>
                                                <th>Estado</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var product in (List<Application.ViewModels.Product.ProductViewModel>)ViewBag.SupplierProducts)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-secondary">@product.Code</span>
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <strong>@product.Name</strong>
                                                            @if (!string.IsNullOrEmpty(product.Description))
                                                            {
                                                                <br><small class="text-muted">@product.Description</small>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(product.CategoryName))
                                                        {
                                                            <span class="badge bg-info">@product.CategoryName</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Sin categoría</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="text-success fw-bold">$@product.PurchasePrice.ToString("N2")</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-primary fw-bold">$@product.SalePrice.ToString("N2")</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @product.StockBadgeClass">
                                                            @product.Stock unidades
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (product.IsActive)
                                                        {
                                                            <span class="badge bg-success">Activo</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Inactivo</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" 
                                                               class="btn btn-sm btn-info" title="Ver detalles">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" 
                                                               class="btn btn-sm btn-warning" title="Editar">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Sin Productos</h5>
                                    <p class="text-muted">Este proveedor no tiene productos registrados en el sistema.</p>
                                    <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
                                        <i class="fas fa-plus me-1"></i>
                                        Agregar Producto
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Ventas del Proveedor -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="text-primary mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Ventas de este Proveedor
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.SupplierSales != null && ((List<Application.ViewModels.Sale.SaleViewModel>)ViewBag.SupplierSales).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID Venta</th>
                                        <th>Fecha</th>
                                        <th>Cliente</th>
                                        <th>Productos</th>
                                        <th>Total</th>
                                        <th>Estado Pago</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sale in (List<Application.ViewModels.Sale.SaleViewModel>)ViewBag.SupplierSales)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">#@sale.Id</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@sale.SaleDate.ToString("dd/MM/yyyy")</small>
                                                <br>
                                                <small class="text-muted">@sale.SaleDate.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong>@sale.CustomerName</strong>
                                            </td>
                                            <td>
                                                @if (sale.Details != null && sale.Details.Any())
                                                {
                                                    <div>
                                                        @foreach (var detail in sale.Details.Take(2))
                                                        {
                                                            <small class="d-block">
                                                                <span class="badge bg-info">@detail.ProductName</span>
                                                                <span class="text-muted">x @detail.Quantity</span>
                                                            </small>
                                                        }
                                                        @if (sale.Details.Count > 2)
                                                        {
                                                            <small class="text-muted">+@(sale.Details.Count - 2) más...</small>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="fw-bold text-success">$@sale.TotalAmount.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="badge @sale.PaymentStatusBadgeClass">@sale.PaymentStatusDisplay</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" 
                                                       class="btn btn-sm btn-info" title="Ver detalles">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-controller="Sales" asp-action="Edit" asp-route-id="@sale.Id" 
                                                       class="btn btn-sm btn-warning" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Sin Ventas</h5>
                            <p class="text-muted">Este proveedor no tiene ventas registradas en el sistema.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 