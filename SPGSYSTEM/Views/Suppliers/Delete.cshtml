@model Application.ViewModels.Supplier.SupplierViewModel

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-trash me-2"></i>
                        Eliminar Proveedor
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>¡Advertencia!</strong> Esta acción no se puede deshacer.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-building me-2"></i>
                                Información del Proveedor
                            </h5>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre:</label>
                                <p class="form-control-plaintext">@Model.Name</p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ContactPerson))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Persona de Contacto:</label>
                                    <p class="form-control-plaintext">@Model.ContactPerson</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <p class="form-control-plaintext">@Model.Email</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Teléfono:</label>
                                    <p class="form-control-plaintext">@Model.Phone</p>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-info-circle me-2"></i>
                                Información del Sistema
                            </h5>

                            <div class="mb-3">
                                <label class="form-label fw-bold">ID del Proveedor:</label>
                                <p class="form-control-plaintext">@Model.Id</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Fecha de Creación:</label>
                                <p class="form-control-plaintext">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Estado:</label>
                                <p>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.UserId))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Usuario Asociado:</label>
                                    <p class="form-control-plaintext">
                                        <span class="badge bg-info">Usuario Configurado</span>
                                    </p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Nota:</strong> Si este proveedor tiene productos asociados, no se podrá eliminar.
                        Los productos deberán ser reasignados a otro proveedor antes de eliminar este registro.
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>
                                Confirmar Eliminación
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i>
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>