@model Application.ViewModels.Supplier.SupplierViewModel

@{
    ViewData["Title"] = "Credenciales del Proveedor";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-key me-2"></i>
                        Credenciales de Acceso
                    </h3>
                    <div class="card-tools">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-building me-2"></i>
                                Información del Proveedor
                            </h5>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre:</label>
                                <p class="form-control-plaintext">@Model.Name</p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ContactPerson))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Persona de Contacto:</label>
                                    <p class="form-control-plaintext">@Model.ContactPerson</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <p class="form-control-plaintext">@Model.Email</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Teléfono:</label>
                                    <p class="form-control-plaintext">@Model.Phone</p>
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-success mb-3">
                                <i class="fas fa-user-lock me-2"></i>
                                Credenciales de Acceso
                            </h5>

                            @if (ViewBag.UserCredentials != null)
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>@ViewBag.UserCredentials.Message</strong>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Usuario:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" value="@ViewBag.UserCredentials.UserName" readonly>
                                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@ViewBag.UserCredentials.UserName')">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <div class="input-group">
                                        <input type="email" class="form-control" value="@ViewBag.UserCredentials.Email" readonly>
                                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('@ViewBag.UserCredentials.Email')">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Nota:</strong> La contraseña no se puede mostrar por seguridad. 
                                    Si el proveedor olvidó su contraseña, contacte al administrador del sistema.
                                </div>

                                                                 
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>No hay credenciales disponibles</strong>
                                    <br>
                                    Este proveedor no tiene credenciales de acceso configuradas.
                                </div>
                            }
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-lightbulb me-2"></i>
                        <strong>Consejos:</strong>
                        <ul class="mb-0 mt-2">
                            <li>El proveedor puede iniciar sesión usando su nombre de usuario o email</li>
                            <li>La contraseña por defecto es: <strong>Proveedor123!</strong></li>
                            <li>Se recomienda que el proveedor cambie su contraseña después del primer acceso</li>
                            <li>El proveedor tendrá acceso al portal de proveedores</li>
                        </ul>
                    </div>

                    <div class="form-group">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Volver a la Lista
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i>
                            Editar Proveedor
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(function() {
        // Mostrar notificación de éxito
        const button = event.target.closest('button');
        const originalIcon = button.innerHTML;
        button.innerHTML = '<i class="fas fa-check"></i>';
        button.classList.remove('btn-outline-secondary');
        button.classList.add('btn-success');
        
        setTimeout(function() {
            button.innerHTML = originalIcon;
            button.classList.remove('btn-success');
            button.classList.add('btn-outline-secondary');
        }, 2000);
    }).catch(function(err) {
        console.error('Error al copiar: ', err);
    });
}


</script> 