@model IEnumerable<Application.ViewModels.Product.ProductViewModel>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="row">
    <div class="col-12">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h4 text-primary mb-1">
                    <i class="fas fa-shopping-bag me-2"></i>Catálogo de Productos
                </h3>
                <p class="text-muted mb-0 small">Explora y compra productos disponibles</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="MyOrders" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-shopping-cart me-2"></i>Mis Compras
                </a>
            </div>
        </div>

        <!-- Alert Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Any())
        {
            <!-- Search Bar -->
            <div class="card mb-3">
                <div class="card-body">
                    <form method="get" asp-action="Search" class="row g-2">
                        <div class="col-md-8">
                            <input type="text" name="term" class="form-control" placeholder="Buscar productos por nombre o código..." 
                                   value="@ViewBag.SearchTerm">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Buscar
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="row g-3">
                @foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="card-title mb-0">@product.Name</h6>
                                    <span class="badge @product.StockBadgeClass">@product.Stock unidades</span>
                                </div>
                                
                                <p class="card-text text-muted small mb-2">
                                    <strong>Código:</strong> @product.Code
                                </p>
                                
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p class="card-text small mb-2">@product.Description</p>
                                }
                                
                                @if (!string.IsNullOrEmpty(product.CategoryName))
                                {
                                    <p class="card-text small mb-2">
                                        <span class="badge bg-info">@product.CategoryName</span>
                                    </p>
                                }
                                
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-primary fw-bold fs-5">$@product.SalePrice.ToString("N2")</span>
                                    </div>
                                    <a asp-action="ProductDetails" asp-route-id="@product.Id" 
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i>Ver Detalles
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Statistics Section -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card bg-light">
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <h4 class="text-primary mb-1">@Model.Count()</h4>
                                        <small class="text-muted">Productos Disponibles</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <h4 class="text-success mb-1">@Model.Count(p => p.Stock > 10)</h4>
                                        <small class="text-muted">Buen Stock</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <h4 class="text-warning mb-1">@Model.Count(p => p.Stock <= 10 && p.Stock > 0)</h4>
                                        <small class="text-muted">Stock Limitado</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="stat-item">
                                        <h4 class="text-info mb-1">@Model.Count(p => !string.IsNullOrEmpty(p.CategoryName))</h4>
                                        <small class="text-muted">Con Categoría</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="fas fa-shopping-bag text-muted" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-muted mb-3">No hay productos disponibles</h4>
                <p class="text-muted mb-4">En este momento no hay productos en stock para mostrar</p>
                <a asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="fas fa-refresh me-2"></i>Actualizar Catálogo
                </a>
            </div>
        }
    </div>
</div> 