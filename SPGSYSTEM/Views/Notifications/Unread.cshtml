@model List<Application.ViewModels.Notification.NotificationViewModel>

@{
    ViewData["Title"] = "Notificaciones No Leídas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle me-2"></i>Notificaciones No Leídas
                    </h3>
                    <div>
                        <a href="@Url.Action("Index")" class="btn btn-primary btn-sm">
                            <i class="fas fa-list me-1"></i>Todas las Notificaciones
                        </a>
                        <form method="post" action="@Url.Action("MarkAllAsRead")" style="display: inline;">
                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('¿Marcar todas como leídas?')">
                                <i class="fas fa-check-double me-1"></i>Marcar Todas como Leídas
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5 class="text-success">¡Excelente!</h5>
                            <p class="text-muted">No tienes notificaciones sin leer.</p>
                            <a href="@Url.Action("Index")" class="btn btn-primary">
                                <i class="fas fa-list me-1"></i>Ver Todas las Notificaciones
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle me-2"></i>
                            Tienes <strong>@Model.Count</strong> notificación(es) sin leer.
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Mensaje</th>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Cliente</th>
                                        <th>Fecha</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var notification in Model)
                                    {
                                        <tr class="table-warning">
                                            <td>
                                                <strong>@notification.Title</strong>
                                            </td>
                                            <td>@notification.Message</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(notification.ProductName))
                                                {
                                                    <span class="badge bg-info">@notification.ProductName</span>
                                                }
                                            </td>
                                            <td>
                                                @if (notification.Quantity.HasValue)
                                                {
                                                    <span class="badge bg-primary">@notification.Quantity</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(notification.CustomerName))
                                                {
                                                    <span class="badge bg-secondary">@notification.CustomerName</span>
                                                }
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </small>
                                            </td>
                                            <td>
                                                <form method="post" action="@Url.Action("MarkAsRead", new { id = notification.Id })" style="display: inline;">
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="fas fa-check me-1"></i>Marcar como Leída
                                                    </button>
                                                </form>
                                                @if (notification.SaleId.HasValue)
                                                {
                                                    <a href="@Url.Action("Details", "Sales", new { id = notification.SaleId })" class="btn btn-info btn-sm">
                                                        <i class="fas fa-eye me-1"></i>Ver Venta
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh cada 15 segundos para nuevas notificaciones
        setInterval(function() {
            location.reload();
        }, 15000);
    </script>
} 